# Copy this file to .env (same folder) and fill it in. .env is git-ignored; never commit it.
# Used by local scripts (model spike, seed, evaluation) and by the web app when running locally.

# Baseten: the key from your Baseten email. Model is fixed: meta-models/muse-spark-open-1026
BASETEN_API_KEY=

# Supabase: Project Settings > API (and > General for the project ref)
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The web app reads only VITE_ variables. Set these same two in Vercel when you deploy.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
