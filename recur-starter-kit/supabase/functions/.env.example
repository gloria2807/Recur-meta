# Copy this file to supabase/functions/.env and fill it in. It is git-ignored.
# These are secrets for the Edge Functions. Upload them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and the service role key are provided to functions automatically; don't add them here.)

BASETEN_API_KEY=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYSTACK_CREDENTIAL_ENCRYPTION_KEY=

# Your deployed web app address, used for redirects (e.g. https://recur-xyz.vercel.app)
APP_URL=

# Optional, only if you set up Gmail. Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
